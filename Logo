    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Project Detail: Data Analyzer Tool</title>
    <!-- Load Tailwind CSS via CDN -->
    <script src="https://cdn.tailwindcss.com"></script>
    <style>
        @import url('https://fonts.googleapis.com/css2?family=Inter:wght@400;600;800&family=Fira+Code:wght@400;600&display=swap');
        body {
            font-family: 'Inter', sans-serif;
            background-color: #111827; /* Near-black background */
            min-height: 100vh;
        }
        /* Custom style for the code block */
        .code-box {
            font-family: 'Fira Code', monospace;
            background-color: #1f2937; /* Darker grey for contrast */
            border: 1px solid #374151; /* Subtle border */
        }
    </style>
</head>
<body class="text-gray-100 bg-gray-900 pb-12">

    <!-- Header and Navigation Link -->
    <header class="bg-gray-800 py-4 border-b border-red-600/50">
        <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 flex justify-between items-center">
            <h1 class="text-2xl font-bold text-red-500">Project: Logo Starter</h1>
            <!-- Mock Link back to main portfolio -->
            <a href="/index.html" class="text-gray-300 hover:text-red-500 transition duration-150 text-sm font-medium">
                &larr; Back to Portfolio Showcase
            </a>
        </div>
    </header>

    <!-- Main Content Grid -->
    <main class="max-w-6xl mx-auto p-4 sm:p-6 lg:p-8 space-y-12">

        <!-- Section 1: Description and Purpose (Two Columns) -->
        <section class="grid lg:grid-cols-3 gap-8 bg-gray-800 p-8 rounded-xl shadow-xl">
            <!-- Column 1: Description & Purpose -->
            <div class="lg:col-span-2 space-y-6">
                <h2 class="text-3xl font-bold text-red-500 border-b border-gray-700 pb-2">Description and Purpose</h2>
                <p class="text-lg text-gray-400">
Logo Maker                 </p>
                <ul class="list-disc list-inside text-gray-400 space-y-2 pl-4">
                </ul>
                <div class="pt-4">                </div>
            </div>

            <!-- Column 2: Visual Asset Placeholder -->
            <div class="lg:col-span-1 bg-gray-700 rounded-lg p-4 border border-red-700/50 flex flex-col items-center justify-center">
        </section>

        <!-- Section 2: Project Code -->
        <section class="space-y-6">
            <h2 class="text-3xl font-bold text-red-500 border-b border-gray-700 pb-2">Core Project Code</h2>
            <img src="/logo.png">
            <div class="code-box p-6 rounded-xl shadow-2xl overflow-x-auto">
    </main>

    <!-- Footer -->
    <footer class="mt-12 py-6 bg-gray-800 text-center text-gray-500 text-sm border-t border-gray-700">
        <p>Developed by Alex for Intro to Computer Science & App Development.</p>
    </footer>

</body>
</html>
